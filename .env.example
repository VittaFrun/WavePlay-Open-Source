# URL HTTPS de tu API autorizada, sin barra final.
EXPO_PUBLIC_AUDIO_SERVICE_URL=https://tu-servidor.example

# Clave opcional para la búsqueda en Explorar; restrínge la clave en Google Cloud.
EXPO_PUBLIC_YOUTUBE_API_KEY=tu-clave-restringida

# Supabase Auth opcional. Usa la Publishable key del proyecto (nunca Secret/service_role).
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu_clave

# Client ID OAuth de tipo Web application (público); el Client Secret solo va en Supabase.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=tu-id.apps.googleusercontent.com
